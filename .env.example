# 合作洽詢頁需要的環境變數。正式站設定在 Vercel 專案的 Settings → Environment Variables，
# 本機測試則複製成 .env.local（已在 .gitignore，不會被提交）。這個範例檔不要放真正的金鑰。

# Gemini API 金鑰（AI 小幫手）：到 Google AI Studio 建立，這個專案不要綁帳單，額度用完只會暫停、不會收費
GEMINI_API_KEY=
# 選填，預設 gemini-3.5-flash-lite
GEMINI_MODEL=

# LINE 官方帳號 Messaging API（合作需求表單通知）
LINE_CHANNEL_ACCESS_TOKEN=
# 你自己的 LINE userId（U 開頭 33 碼，在 LINE Developers 的 Basic settings → Your user ID），不是 LINE ID
LINE_OWNER_USER_ID=

# 選填：LINE 官方帳號加好友網址。程式裡已預設 @253nhvlz，要換帳號時再設定
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=
